{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node \"$(git rev-parse --show-toplevel)/scripts/vercel.mjs\" install",
  "buildCommand": "node \"$(git rev-parse --show-toplevel)/scripts/vercel.mjs\" build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/dist/**",
      "maxDuration": 30
    },
    "api/[...path].js": {
      "includeFiles": "apps/api/dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
