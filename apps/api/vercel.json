{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev --ignore-scripts=false",
  "buildCommand": "npm run build && node -e \"require('fs').cpSync('dist','api/nest',{recursive:true})\"",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/[...path].js": {
      "maxDuration": 30
    }
  }
}
